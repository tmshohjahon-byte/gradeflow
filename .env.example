# GradeFlow Supabase Environment Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Service Role (Privileged key to bypass RLS in backend APIs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Enterprise Cryptographic Session Security (JWT)
JWT_SECRET=your-random-cryptographic-jwt-secret-min-32-chars

# Real Email OTP Configuration (Gmail SMTP or Resend)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
